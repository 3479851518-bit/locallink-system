# LocalLink 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ========================================
# 服务器配置
# ========================================
SERVER_PORT=8080

# ========================================
# 数据库配置
# ========================================
DB_URL=jdbc:mysql://localhost:3306/locallink?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# ========================================
# RabbitMQ配置
# ========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# ========================================
# 文件上传配置
# ========================================
FILE_UPLOAD_PATH=uploads
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB
AVATAR_MAX_SIZE=5242880
GROUP_AVATAR_MAX_SIZE=5242880

# ========================================
# WebSocket配置
# ========================================
WS_HEARTBEAT_INTERVAL=30000
WS_RECALL_TIME_LIMIT=120

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=DEBUG
SPRING_WEB_LOG_LEVEL=INFO
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.stdout.StdOutImpl
