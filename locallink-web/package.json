{
  "name": "locallink-client",
  "version": "1.0.0",
  "type": "module",
  "description": "局域网即时通讯系统客户端",
  "main": "electron/main.cjs",
  "author": "LocalLink",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build-win": "powershell -ExecutionPolicy Bypass -File scripts/build-win.ps1",
    "package:desktop": "powershell -ExecutionPolicy Bypass -File scripts/package-all.ps1",
    "electron:reinstall": "node scripts/reinstall-electron.js"
  },
  "build": {
    "appId": "com.locallink.client",
    "productName": "LocalLink",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "target",
        "to": "backend",
        "filter": ["*.jar"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "sign": false,
      "signAndEditExecutable": false,
      "signingHashAlgorithms": [],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalLink"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "axios": "^1.6.0",
    "element-plus": "^2.5.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "electron-builder-squirrel-windows": "^24.13.0",
    "vite": "^5.1.0"
  }
}
